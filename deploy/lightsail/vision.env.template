# Settings for vision.mycomap.org. provision.sh copies this to
# /etc/mycomap-vision/vision.env (mode 600) and links <repo>/.env to it, so the
# service and the `mv` command read the same values. Fill in the <...> values.
# No secrets go in here: the session secret, the sign-in public key and the AWS
# key live in their own files.

# Where releases are pulled to; the server serves the one current.txt names.
MV_RELEASE_ROOT=/srv/mycomap-vision

# The private bucket and its region (the same as on the laptop's .env).
MV_S3_BUCKET=<BUCKET>
MV_AWS_REGION=<REGION>
# The read-only AWS profile a person entered with `aws configure --profile ...`.
MV_AWS_PROFILE=mycomap-vision-box

# Sign-in with a mycomap.org account: all = the whole site (pre-launch),
# identify = only identifications, off = open.
MV_SIGNIN=all
MV_PUBLIC_ORIGIN=https://vision.mycomap.org
MV_SIGNIN_ISSUER=https://mycomap.org
MV_SIGNIN_PUBLIC_KEY_FILE=/etc/mycomap-vision/signin-public.pem
MV_SESSION_SECRET_FILE=/etc/mycomap-vision/session-secret

# What the public API may run. One model on the 4 GB box.
MV_ALLOWED_BACKBONES=bioclip-2
MV_RATE_LIMIT=30/600
MV_MAX_QUEUE=2

# Model weights cache (filled by provision.sh) and CPU threads (2 vCPUs).
HF_HOME=/srv/mycomap-vision/hf
HF_HUB_OFFLINE=1
OMP_NUM_THREADS=2
