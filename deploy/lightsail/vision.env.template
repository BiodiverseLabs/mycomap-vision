# Settings for vision.mycomap.org. provision.sh copies this to
# /etc/mycomap-vision/vision.env (mode 600) and links <repo>/.env to it, so the
# service and the `mv` command read the same values. Fill in the <...> values.
# No secrets go in here: the session secret, the sign-in public key and the AWS
# key live in their own files.

# Where releases are pulled to; the server serves the one current.txt names.
MV_RELEASE_ROOT=/srv/mycomap-vision

# The private bucket and its region (the same as on the laptop's .env).
MV_S3_BUCKET=<BUCKET>
MV_AWS_REGION=<REGION>
# The read-only AWS profile a person entered with `aws configure --profile ...`.
MV_AWS_PROFILE=mycomap-vision-box

# Sign-in with a mycomap.org account: all = the whole site (pre-launch),
# identify = only identifications, off = open.
MV_SIGNIN=all
MV_PUBLIC_ORIGIN=https://vision.mycomap.org
MV_SIGNIN_ISSUER=https://mycomap.org
MV_SIGNIN_PUBLIC_KEY_FILE=/etc/mycomap-vision/signin-public.pem
MV_SESSION_SECRET_FILE=/etc/mycomap-vision/session-secret

# Photographers' answers from mycomap.org (permissions.py), re-read every 5 minutes.
# The key is the value set as VISION_API_KEY on mycomap.org, in its own file
# (mode 600, owner ubuntu). Without it, all-rights-reserved photos are never shown.
MV_ORG_BASE_URL=https://mycomap.org
MV_ORG_VISION_KEY_FILE=/etc/mycomap-vision/org-vision-key
# Re-read photo licences from iNat daily (~800 requests at 1/s).
MV_LICENSE_REFRESH_HOURS=24

# The nightly update (nightly.py, docs/deploy.md "Nightly update"): new, removed and
# renamed green records from mycomap.org every night at 3 a.m. Eastern, with the key
# above. Off until mycomap.org serves /api/vision/green-records and Cloudflare lets
# this box through to /api/vision/; check first with `mv nightly --plan`.
# MV_NIGHTLY=1

# What the public API may run. One model on the 4 GB box, and only the method that
# answers in seconds; the box never trains a classifier itself (minutes of CPU now,
# hours at the full photo set): trained methods come ready-made in a release.
MV_ALLOWED_BACKBONES=bioclip-2
MV_METHODS=nearest,nearest+mean
# The method used when none is named (Steve 2026-10-09: nearest + species average). It must
# be in MV_METHODS, and its calibration must be on this box's scoreboard (import the
# comparison's rows with mv scoreboard-import) before it is switched on.
MV_DEFAULT_METHOD=nearest+mean
MV_FIT_ON_DEMAND=0
# At most this many models per identification (side-by-side comparison).
MV_MAX_MODELS=2
# Load it (and its index) at startup, not on the first identification.
MV_PRELOAD=default
MV_RATE_LIMIT=30/600
MV_MAX_QUEUE=2

# Model weights cache (filled by provision.sh) and CPU threads (2 vCPUs).
HF_HOME=/srv/mycomap-vision/hf
HF_HUB_OFFLINE=1
OMP_NUM_THREADS=2
