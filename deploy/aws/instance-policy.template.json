{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteVisionBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": ["arn:aws:s3:::{{BUCKET}}", "arn:aws:s3:::{{BUCKET}}/*"]
    }
  ]
}
