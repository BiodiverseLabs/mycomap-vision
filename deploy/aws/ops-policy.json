{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisionBucketOnly",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket", "s3:ListBucket", "s3:GetBucketLocation",
        "s3:PutBucketPublicAccessBlock", "s3:PutEncryptionConfiguration", "s3:PutBucketTagging",
        "s3:PutLifecycleConfiguration",
        "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"
      ],
      "Resource": ["arn:aws:s3:::YOUR-BUCKET", "arn:aws:s3:::YOUR-BUCKET/*"]
    },
    {
      "Sid": "LatestAmazonLinuxImage",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-2::parameter/aws/service/ami-amazon-linux-latest/*"
    },
    {
      "Sid": "Describe",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus", "ec2:DescribeImages",
                 "ec2:DescribeSubnets", "ec2:DescribeVpcs", "ec2:DescribeSecurityGroups"],
      "Resource": "*"
    },
    {
      "Sid": "LaunchOnlyTaggedInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": ["arn:aws:ec2:us-east-2:*:instance/*", "arn:aws:ec2:us-east-2:*:volume/*"],
      "Condition": {"StringEquals": {"aws:RequestTag/Project": "mycomap-vision"}}
    },
    {
      "Sid": "LaunchSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-2::image/*",
        "arn:aws:ec2:us-east-2:*:subnet/*",
        "arn:aws:ec2:us-east-2:*:network-interface/*",
        "arn:aws:ec2:us-east-2:*:security-group/*"
      ]
    },
    {
      "Sid": "TagOnlyAtLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {"StringEquals": {"ec2:CreateAction": "RunInstances"}}
    },
    {
      "Sid": "ManageOnlyOwnInstances",
      "Effect": "Allow",
      "Action": ["ec2:TerminateInstances", "ec2:StopInstances", "ec2:GetConsoleOutput"],
      "Resource": "arn:aws:ec2:us-east-2:*:instance/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Project": "mycomap-vision"}}
    },
    {
      "Sid": "PassOnlyTheInstanceRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/mycomap-vision-instance"
    }
  ]
}
