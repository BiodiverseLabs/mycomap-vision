{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadReleasesOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::{{BUCKET}}/releases/*"
    },
    {
      "Sid": "SiteRunLinks",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::{{BUCKET}}/site-runs/*"
    }
  ]
}
