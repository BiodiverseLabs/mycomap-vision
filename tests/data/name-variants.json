  "groups": [
    {
      "rule": "An old-format spelling joins the house-style spelling, which is kept",
      "rows": [
        [
          "Clitocybe sp. 'PNW01'",
          112
        ],
        [
          "Clitocybe \"sp-PNW01\"",
          6
        ]
      ],
      "expect": {
        "proposedName": "Clitocybe sp. 'PNW01'",
        "proposedIsNew": false,
        "confidence": "same",
        "recordsToFix": 6
      }
    },
    {
      "rule": "An old-format spelling on its own is rewritten into house style",
      "rows": [
        [
          "Galerina \"sp-CA02\"",
          24
        ]
      ],
      "expect": {
        "proposedName": "Galerina sp. 'CA02'",
        "proposedIsNew": true,
        "confidence": "same",
        "recordsToFix": 24
      }
    },
    {
      "rule": "The hyphenated spelling is kept even when the spaced one has more records",
      "rows": [
        [
          "Clitocybe sp. 'fuscidisca PNW10'",
          65
        ],
        [
          "Clitocybe sp. 'fuscidisca-PNW10'",
          31
        ]
      ],
      "expect": {
        "proposedName": "Clitocybe sp. 'fuscidisca-PNW10'",
        "proposedIsNew": false,
        "confidence": "same",
        "recordsToFix": 65
      }
    },
    {
      "rule": "A hyphen before the number never changes a name that is already in house style",
      "rows": [
        [
          "Amanita sp. 'flavoconia-01'",
          199
        ],
        [
          "Amanita \"flavoconia-01\"",
          24
        ]
      ],
      "expect": {
        "proposedName": "Amanita sp. 'flavoconia-01'",
        "proposedIsNew": false,
        "confidence": "same",
        "recordsToFix": 24
      }
    },
    {
      "rule": "IN7 and IN07 are grouped, the two-digit spelling is proposed, and a person checks",
      "rows": [
        [
          "Mycena sp. 'IN7'",
          88
        ],
        [
          "Mycena sp. 'IN07'",
          16
        ]
      ],
      "expect": {
        "proposedName": "Mycena sp. 'IN07'",
        "proposedIsNew": false,
        "confidence": "check",
        "recordsToFix": 88
      }
    },
    {
      "rule": "A code that is also in use as a plain name is for a person to decide",
      "rows": [
        [
          "Craterellus sp. 'neotubaeformis'",
          55
        ],
        [
          "Craterellus neotubaeformis",
          19
        ]
      ],
      "expect": {
        "proposedName": null,
        "proposedIsNew": false,
        "confidence": "check",
        "recordsToFix": 74
      }
    },
    {
      "rule": "A non-breaking space is the same name",
      "rows": [
        [
          "Tricholoma lutescentifolium",
          40
        ],
        [
          "Tricholoma lutescentifolium\u00a0",
          7
        ]
      ],
      "expect": {
        "proposedName": "Tricholoma lutescentifolium",
        "proposedIsNew": false,
        "confidence": "same",
        "recordsToFix": 7
      }
    },
    {
      "rule": "A described code keeps its spaces, and a respelling of it is checked by a person",
      "rows": [
        [
          "Neoboletus sp. 'AZ brown 01'",
          9
        ],
        [
          "Neoboletus sp. 'AZ-brown-01'",
          1
        ]
      ],
      "expect": {
        "proposedName": "Neoboletus sp. 'AZ-brown-01'",
        "proposedIsNew": false,
        "confidence": "check",
        "recordsToFix": 9
      }
    }
