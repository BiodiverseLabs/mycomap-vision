# Copy to .env (git-ignored) and fill in. Real environment variables win over .env.

# Where downloads, the manifest and embeddings live (default: ./data).
# MV_DATA_DIR=

# SSH host of a read-only SQL route to the mycomap.org database, used only by
# `mv export-records`. It must accept one SQL statement and answer a header line
# followed by one row per line.
MV_ORG_SQL_SSH_HOST=

# AWS (only for the S3 downloader and `mv aws-policies`).
MV_S3_BUCKET=
MV_AWS_REGION=
MV_AWS_PROFILE=
# MV_INSTANCE_ROLE=mycomap-vision-instance

# Public API limits (`mv serve`); defaults shown.
# MV_ALLOWED_BACKBONES=      # comma list; default: the aliases in models.py
# MV_RATE_LIMIT=30/600       # identify requests per IP per 600 seconds
# MV_MAX_QUEUE=4             # identify requests allowed to wait for the GPU

# Sign-in with a mycomap.org account (signin.py); defaults shown. The server box
# uses MV_SIGNIN=all before launch (deploy/lightsail/vision.env.template).
# MV_SIGNIN=off                # off | identify | all
# MV_PUBLIC_ORIGIN=            # this site, e.g. https://vision.mycomap.org
# MV_SIGNIN_ISSUER=https://mycomap.org
# MV_SIGNIN_PUBLIC_KEY_FILE=   # mycomap.org's sign-in bridge public key (PEM)
# MV_SESSION_SECRET_FILE=      # 32+ random bytes that sign this site's cookies
# MV_SESSION_DAYS=7
# MV_FORWARDED_ALLOW_IPS=127.0.0.1   # proxies whose X-Forwarded-For is trusted

# Server box only: serve the release <root>/current.txt names (release.py)
# instead of MV_DATA_DIR. See docs/deploy.md.
# MV_RELEASE_ROOT=
