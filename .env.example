# Copy to .env (git-ignored) and fill in. Real environment variables win over .env.

# Where downloads, the manifest and embeddings live (default: ./data).
# MV_DATA_DIR=

# SSH host of a read-only SQL route to the mycomap.org database, used only by
# `mv export-records`. It must accept one SQL statement and answer a header line
# followed by one row per line.
MV_ORG_SQL_SSH_HOST=

# AWS (only for the S3 downloader and `mv aws-policies`).
MV_S3_BUCKET=
MV_AWS_REGION=
MV_AWS_PROFILE=
# MV_INSTANCE_ROLE=mycomap-vision-instance

# Public API limits (`mv serve`); defaults shown.
# MV_ALLOWED_BACKBONES=      # comma list; default: the aliases in models.py
# MV_RATE_LIMIT=30/600       # identify requests per IP per 600 seconds
# MV_MAX_QUEUE=4             # identify requests allowed to wait for the GPU
