# Copy to .env (git-ignored) and fill in. Real environment variables win over .env.

# Where downloads, the manifest and embeddings live (default: ./data).
# MV_DATA_DIR=
# Another manifest than <MV_DATA_DIR>/manifest.sqlite (e.g. a copy to try a command on);
# embeddings and models are still read from MV_DATA_DIR.
# MV_MANIFEST_PATH=

# The private research checkout: the experiment registry (experiments/) and the paper
# draft (paper/draft.md), kept out of this public repo. Default: ../mycomap-vision-research.
# MV_RESEARCH_DIR=

# SSH host of a read-only SQL route to the mycomap.org database, used only by
# `mv export-records`. It must accept one SQL statement and answer a header line
# followed by one row per line.
MV_ORG_SQL_SSH_HOST=

# AWS (only for the S3 downloader and `mv aws-policies`).
MV_S3_BUCKET=
MV_AWS_REGION=
MV_AWS_PROFILE=
# MV_INSTANCE_ROLE=mycomap-vision-instance

# Public API limits (`mv serve`); defaults shown.
# MV_ALLOWED_BACKBONES=      # comma list; default: the aliases in models.py
# MV_RATE_LIMIT=30/600       # identify requests per IP per 600 seconds
# MV_MAX_QUEUE=4             # identify requests allowed to wait for the GPU
# MV_METHODS=                # comma list of methods offered; default: all
# MV_FIT_ON_DEMAND=1         # 0: refuse a trained method with no saved training
# MV_MAX_MODELS=             # most models one identification may compare; default: no limit
# MV_PRELOAD=off             # backbone/method list, or "default", to load at startup

# Public API v1 (docs/api.md); each part off unless turned on. /api/v1/ answers only a
# credential: mycomap.org's key (MV_ORG_VISION_KEY below), an app token .org minted
# (checked with MV_SIGNIN_PUBLIC_KEY_FILE for MV_PUBLIC_ORIGIN) or a vision_ token
# (checked with .org at MV_ORG_BASE_URL).
# MV_TAXON_COUNTS=0          # 1: GET /api/v1/taxon-counts
# MV_API_V1=0                # 1: POST /api/v1/identify (app tokens, vision_ tokens via .org)
# MV_PHOTOS_PER_MINUTE=20    # v1: photos per member (or overridden key) per minute
# MV_QUEUE_MAX_WAIT=20       # refuse (503 busy) when the work ahead would take longer, in seconds
# MV_QUEUE_BATCH_PHOTOS=20   # most photos scored together in one search pass
# MV_SESSIONS=0              # 1: the app's observation sessions under /api/v1/sessions
# MV_BY_OBSERVATION=0        # 1: identify by iNat/MO observation number (needs MV_API_V1=1)
# MV_SESSIONS_MAX_MB=64      # memory for open sessions (vectors and last answers, never photos)
# MV_SEARCH_INT8=0           # 1: fast int8 search (fastsearch.py): ~0.05 s not ~2 s a call; +~0.5 GB held
# MV_SEARCH_REFINE=4096      # each query's best columns re-scored exactly
# MV_EMBED_ONNX=0            # 1: embed with models/<b>.onnx (mv export-onnx) when it matches the served weights
# MV_PHOTO_TAGGER=           # the photo-type tagger file (mv photo-tagger build): tags each identified
#                            # photo; high-band micrograph/label photos leave the answer. Unset: off
# MV_QUOTAS=off              # off | count (count, show, report; never refuse) | enforce
# MV_QUOTA_DEFAULT_MONTHLY=100   # identifications a month for a credential that names no limit
# MV_USAGE_REPORT_SECONDS=300    # how often use is reported to mycomap.org (MV_ORG_BASE_URL + key)
# MV_INDEX_WAIT_SECONDS=20   # how long an identification waits for a rebuilt index
#                            # (e.g. after a withdrawal) before "try again shortly"

# Sign-in with a mycomap.org account (signin.py); defaults shown. The server box
# uses MV_SIGNIN=all before launch (deploy/lightsail/vision.env.template).
# MV_SIGNIN=off                # off | identify | all
# MV_PUBLIC_ORIGIN=            # this site, e.g. https://vision.mycomap.org
# MV_SIGNIN_ISSUER=https://mycomap.org
# MV_SIGNIN_PUBLIC_KEY_FILE=   # mycomap.org's sign-in bridge public key (PEM)
# MV_SESSION_SECRET_FILE=      # 32+ random bytes that sign this site's cookies
# MV_SESSION_DAYS=7
# MV_FORWARDED_ALLOW_IPS=127.0.0.1   # proxies whose X-Forwarded-For is trusted

# Run links (runs.py): every identification on the site kept under its own link /r/<id>,
# with 1024 px copies of uploaded photos (no EXIF). Kept until the person who ran it, or a
# mycomap.org admin, deletes it.
# MV_RUN_LINKS=off               # off | s3 (the bucket's site-runs/) | a folder on this machine
# The Identify page's "Example result": one kept run, shown as its link shows it to anyone.
# MV_EXAMPLE_RUN=                # a run id (the 16 characters after /r/); empty: no example
# "Where Vision looked" on a run's answer (looked.py): each photo's map of where its evidence
# was, made when a signed-in member asks (one photo at a time, behind every identification)
# and kept beside the run as looked.json. Needs run links. On by default; 0 turns it off.
# MV_WHERE_LOOKED=1
# Research > Excluded photos (excluded_looked.py): photos people left out in Human Feedback,
# with "where Vision looked" on any of them (v1's maps only), made on the same worker and kept
# in state/excluded-looked.sqlite. On by default; 0 turns it off. The paper's seal holds maps
# back for records past it until the Paper Coordinator says v1-test's scoring is committed;
# only then set UNSEALED=1.
# MV_EXCLUDED_LOOKED=1
# MV_EXCLUDED_LOOKED_UNSEALED=0
# The preload: every slip photo's and kept crop's map made ahead of anyone asking, one photo at
# a time behind every identification and every person's ask, never while the nightly runs;
# progress in /api/health (excluded_preload). 0 turns it off. WINDOW is its hours in UTC
# (HH:MM-HH:MM, may pass midnight), or "any" for whenever the box is idle. Slip photos wait
# until no kept crop is still waiting for its vector; CROP_WAIT=0 lets them go first.
# MV_EXCLUDED_PRELOAD=1
# MV_EXCLUDED_PRELOAD_WINDOW=07:45-12:45
# MV_EXCLUDED_PRELOAD_CROP_WAIT=1

# iNaturalist's suggestions under Vision's answers (inat_suggest.py): each photo goes to
# mycomap.org (MV_ORG_BASE_URL + key), which asks iNat with the member's own account. Off
# until iNat agrees in writing.
# MV_INAT_SUGGESTIONS=0

# Server box only: serve the release <root>/current.txt names (release.py)
# instead of MV_DATA_DIR. See docs/deploy.md.
# MV_RELEASE_ROOT=

# Photographers' answers from mycomap.org (permissions.py). Without both, `mv serve`
# shows no all-rights-reserved photos and does not pick up refusals.
# MV_ORG_BASE_URL=https://mycomap.org
# MV_ORG_VISION_KEY=          # the value set as VISION_API_KEY on mycomap.org
# MV_ORG_VISION_KEY_FILE=     # or a file holding it (the server box: /etc/mycomap-vision/org-vision-key)
# MV_PERMISSIONS_SYNC_SECONDS=300       # how often `mv serve` re-reads them
# MV_PERMISSIONS_MAX_AGE_SECONDS=3600   # grants older than this are not trusted for showing
# MV_PERMISSIONS_STATE=      # where the last good list is also kept; default on the
#                            # server box: <MV_RELEASE_ROOT>/state/photo-permissions.json

# Re-read photo licences from iNat in `mv serve` (hours between re-reads of a record;
# unset = off). 24 re-reads everything daily: ~800 requests at 1/s.
# MV_LICENSE_REFRESH_HOURS=24

# The nightly update on the server box (nightly.py, docs/deploy.md): new, removed and
# renamed green records from mycomap.org (same key as above), embedded on the box.
# MV_NIGHTLY=0
# MV_NIGHTLY_AT=03:00                 # local time, in MV_NIGHTLY_TZ
# MV_NIGHTLY_TZ=America/New_York
# MV_NIGHTLY_MAX_PHOTOS=3000          # photos embedded in one night
# MV_NIGHTLY_MAX_CROPS=3000           # Recovered labels: specimen crops embedded in one night (0: none)
# MV_NIGHTLY_PHOTO_SIZE=large         # the size the release's vectors were made from
# MV_NIGHTLY_MAX_REMOVED=500          # removals refused above the larger of this
# MV_NIGHTLY_MAX_REMOVED_SHARE=0.02   # ... and this share of the list
# MV_NIGHTLY_WARN_SHARE=0.20          # nightly photos / release photos that call for a release
# MV_NIGHTLY_PREDICT=300              # advance predictions a night for records awaiting validation (0: none)
# MV_NIGHTLY_CATCHUP_AFTER_HOURS=24   # a new release's layer exported longer ago catches up at startup (0: never)
# MV_NIGHTLY_CATCHUP_DELAY_MINUTES=10 # ... this long after startup, once the preload is done
